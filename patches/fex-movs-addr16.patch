diff --git a/unittests/32Bit_ASM/Primary/Primary_A5_AddrSize16.asm b/unittests/32Bit_ASM/Primary/Primary_A5_AddrSize16.asm
new file mode 100644
index 00000000..68a13b0c
--- /dev/null
+++ b/unittests/32Bit_ASM/Primary/Primary_A5_AddrSize16.asm
@@ -0,0 +1,34 @@
+%ifdef CONFIG
+{
+  "RegData": {
+    "RAX": "0x41424344",
+    "RSI": "0xABCD2004",
+    "RDI": "0x12343004"
+  },
+  "MemoryRegions": {
+    "0x00002000": "4096",
+    "0x00003000": "4096"
+  },
+  "Mode": "32BIT"
+}
+%endif
+
+; movsd with the 0x67 prefix addresses memory through SI and DI only.
+; The upper halves of ESI and EDI are ignored for the access and kept afterwards.
+
+mov eax, 0x17
+mov es, eax
+mov ds, eax
+
+mov dword [0x2000], 0x41424344
+mov dword [0x3000], 0
+
+mov esi, 0xABCD2000
+mov edi, 0x12343000
+
+cld
+a16 movsd
+
+mov eax, [0x3000]
+
+hlt
